<%= render layout: "devise/shared/shell", locals: { title: "Déverrouiller votre compte", description: "Recevez les instructions pour accéder à nouveau à votre espace." } do %>
  <%= form_for(resource, as: resource_name, url: unlock_path(resource_name), html: { method: :post }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="field">
      <p><%= f.label :email %></p>
      <p><%= f.email_field :email, autofocus: true, autocomplete: "email" %></p>
    </div>

    <div class="actions">
      <%= f.button "Renvoyer les instructions de déverrouillage", type: "submit", class: "btn-submit" %>
    </div>
  <% end %>

  <%= render "devise/shared/links" %>
<% end %>
