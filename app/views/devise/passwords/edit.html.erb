<%= render layout: "devise/shared/shell", locals: { title: "Un nouveau départ", recovery: true, description: "Choisissez un nouveau mot de passe pour sécuriser l’accès à votre jardin." } do %>
  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: {
    method: :put, data: { controller: "password-form", action: "invalid->password-form#validate:capture input->password-form#clear" }
  }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <%= f.hidden_field :reset_password_token %>

    <div class="field">
      <p><%= f.label :password, "Nouveau mot de passe" %></p>
      <% if @minimum_password_length %>
        <p class="auth-field-help" id="recovery-password-help"><%= @minimum_password_length %> caractères minimum. Préférez une phrase facile à retenir.</p>
      <% end %>
      <p><%= f.password_field :password, autofocus: true, autocomplete: "new-password", required: true, minlength: @minimum_password_length,
                             aria: { describedby: (@minimum_password_length ? "recovery-password-help" : nil) }, data: { password_form_target: "password" } %></p>
    </div>

    <div class="field">
      <p><%= f.label :password_confirmation, "Confirmer le nouveau mot de passe" %></p>
      <p><%= f.password_field :password_confirmation, autocomplete: "new-password", required: true, data: { password_form_target: "password" } %></p>
    </div>

    <button type="button" class="auth-password-visibility" data-password-form-target="visibilityButton"
            data-action="click->password-form#toggleVisibility" aria-pressed="false">Afficher les mots de passe</button>

    <div class="actions">
      <%= f.button "Modifier mon mot de passe", type: "submit", class: "btn-submit", data: { turbo_submits_with: "Enregistrement en cours…" } %>
    </div>
  <% end %>

  <% if resource.errors.any? %>
    <p class="auth-links"><%= link_to "Demander un nouveau lien", new_password_path(resource_name) %></p>
  <% end %>
  <%= render "devise/shared/links" %>
<% end %>
