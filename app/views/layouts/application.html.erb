<!DOCTYPE html>
<html lang="fr" data-theme="dark">
  <head>
    <script>
      try {
        const theme = localStorage.getItem("smartWatering.theme");
        if (["light", "dark"].includes(theme)) document.documentElement.dataset.theme = theme;
      } catch (_) { /* Keep the default theme when browser storage is unavailable. */ }
      document.documentElement.style.colorScheme = document.documentElement.dataset.theme;
    </script>
    <title><%= content_for(:title) || "Arrosage intelligent" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Arrosage intelligent">
    <meta name="mobile-web-app-capable" content="yes">
    <%#= csrf_meta_tags %>
    <%#= csp_meta_tag %>

    <!-- WEB AWESOME-->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@shoelace-style/shoelace@2.19.1/cdn/themes/light.css" />

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <script type="module" src="https://cdn.jsdelivr.net/npm/@shoelace-style/shoelace@2.19.1/cdn/shoelace-autoloader.js"></script>

    <%= yield :head %>
  </head>

  <body data-controller="appearance"
        data-action="scroll@window->appearance#updateScroll turbo:render@document->appearance#refresh turbo:load@document->appearance#updateScroll">
  <%= render "layouts/header" %>

  <% flash.each do |type, message| %>
    <p class="flash-message" role="<%= type.to_s == "alert" ? "alert" : "status" %>"><%= message %></p>
  <% end %>

  <main class="app-main" id="main-content">
    <%= yield %>
  </main>

  <%= render "layouts/footer" %>
  <button type="button" class="back-to-top" data-appearance-target="backToTop"
          data-action="click->appearance#scrollToTop" aria-label="Retour en haut" title="Retour en haut" hidden>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 14 6-6 6 6" /></svg>
  </button>
  </body>
</html>
