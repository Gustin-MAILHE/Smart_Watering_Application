<header data-controller="drawer">
  <div class="container">
    <!-- Burger -->
    <button type="button" id="open-menu" class="burger-button" data-action="click->drawer#open" aria-label="Menu">
      <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>

    <sl-drawer data-drawer-target="drawer" label="Navigation" placement="start" id="sidebar-drawer">
      <nav class="navbar">
        <ul class="up_navigation">
          <li class="active">
            <%= link_to root_path do %>
              <%= image_tag "home_icon.svg", alt: "home_icon" %>
              <span>Home</span>
            <% end %>
          </li>
          <li>
            <%= link_to accounts_path do %>
              <%= image_tag "account_icon.svg", alt: "account_icon" %>
              <span>Account</span>
            <% end %>
          </li>
          <li>
            <%= link_to stats_path do %>
              <%= image_tag "stats_icon.svg", alt: "stats_icon" %>
              <span>Stats</span>
            <% end %>
          </li>
        </ul>
        <div class="space"></div>
        <ul class="down_navigation">
          <li>
            <%= link_to settings_path do %>
              <%= image_tag "setting_icon.svg", alt: "setting_icon" %>
              <span>Settings</span>
            <% end %>
          </li>
          <li>
            <%= link_to themes_path do %>
              <%= image_tag "dark_icon.svg", alt: "dark_icon" %>
              <span>Dark</span>
            <% end %>
          </li>
          <li>
            <%= link_to abouts_path do %>
              <%= image_tag "about_icon.svg", alt: "about_icon" %>
              <span>About</span>
            <% end %>
          </li>
        </ul>
      </nav>
    </sl-drawer>
  </div>
</header>

