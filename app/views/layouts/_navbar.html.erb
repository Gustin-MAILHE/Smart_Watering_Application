<div data-controller="drawer">
  <div class="container">
    <!-- Burger -->
    <button type="button" id="open-menu" class="burger-button" data-action="click->drawer#open" aria-label="Menu">
      <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>

    <sl-drawer data-drawer-target="drawer" label="Navigation" placement="start" id="sidebar-drawer">
      <nav class="navbar">
        <ul class="up_navigation">
          <li class="<%= 'active' if current_page?(root_path) %>">
            <%= link_to root_path do %>
              <%= inline_svg_tag "home_icon.svg", aria: { hidden: true } %>
              <span>Accueil</span>
            <% end %>
          </li>
          <li class="<%= 'active' if current_page?(gardens_path) %>">
            <%= link_to gardens_path do %>
              <%= inline_svg_tag "garden_icon.svg", aria: { hidden: true } %>
              <span>Jardin</span>
            <% end %>
          </li>
          <li class="<%= 'active' if current_page?(accounts_path) %>">
            <%= link_to accounts_path do %>
              <%= inline_svg_tag "account_icon.svg", aria: { hidden: true } %>
              <span>Compte</span>
            <% end %>
          </li>
          <li class="<%= 'active' if current_page?(stats_path) %>">
            <%= link_to stats_path do %>
              <%= inline_svg_tag "stats_icon.svg", aria: { hidden: true } %>
              <span>Statistiques</span>
            <% end %>
          </li>
        </ul>
        <div class="space"></div>
        <ul class="down_navigation">
          <li class="<%= 'active' if current_page?(settings_path) %>">
            <%= link_to settings_path do %>
              <%= inline_svg_tag "setting_icon.svg", aria: { hidden: true } %>
              <span>Paramètres</span>
            <% end %>
          </li>
          <li class="<%= 'active' if current_page?(abouts_path) %>">
            <%= link_to abouts_path do %>
              <%= inline_svg_tag "about_icon.svg", aria: { hidden: true } %>
              <span>About</span>
            <% end %>
          </li>
        </ul>
        <ul class="down_navigation">
          <% if user_signed_in? %>
            <li>Connecté en tant que :
              <strong><%= current_user.username %></strong>
              <%= button_to "Se déconnecter", destroy_user_session_path, method: :delete, class: "btn-submit" %>
            </li>
          <% else %>
            <li>
              <%= link_to "Se connecter", new_user_session_path, class: "btn-submit"%>
            </li>

          <% end %>
        </ul>
      </nav>
    </sl-drawer>
  </div>
</div>
